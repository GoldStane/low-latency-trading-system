execute_process(COMMAND "${IBKR}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "No order execution" OR NOT error STREQUAL "")
    message(FATAL_ERROR "IBKR help failed: ${result}, ${output}, ${error}")
endif()
function(expect_failure)
    execute_process(COMMAND "${IBKR}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "Expected pre-connect CLI failure: ${result}, ${output}, ${error}")
    endif()
endfunction()
expect_failure()
expect_failure(--symbol)
expect_failure(--symbol AAPL --port 0)
expect_failure(--symbol AAPL --client-id -1)
expect_failure(--symbol AAPL --market-data-mode 5)
expect_failure(--symbol AAPL --instrument-id 4294967296)
expect_failure(--symbol AAPL --symbol MSFT)
expect_failure(--symbol AAPL --tick-size NaN)
expect_failure(--symbol AAPL --tick-size 0)
expect_failure(--symbol AAPL --startup-timeout-seconds 0)
expect_failure(--unknown value)
